# Target Ethereum Chain ID: 11155111 for Sepolia, 31337 for Localhost Hardhat
VITE_TARGET_CHAIN_ID=11155111

# Smart Contract Addresses (Populated automatically by deploy script, or manually set)
VITE_CREDENTIAL_NFT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
VITE_REWARD_TOKEN_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
VITE_REGISTRY_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0

# Sepolia Public RPC (for read-only verification queries when no wallet is connected)
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Backend API Endpoint
VITE_API_URL=http://localhost:5000/api
