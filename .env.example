# ==============================================================================
# SkillS — Decentralized Learning & Verified Credentials Platform
# Root Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Smart Contract & Blockchain Deployment (Sepolia Testnet)
# ------------------------------------------------------------------------------
# Ethereum Sepolia Testnet RPC URL (Public node or Infura/Alchemy)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Deployer Private Key for Sepolia Testnet (DO NOT USE MAINNET - NEVER COMMIT REAL KEYS)
PRIVATE_KEY=

# Etherscan API Key for automated contract verification
ETHERSCAN_API_KEY=

# ------------------------------------------------------------------------------
# 2. Frontend Web3 Configuration (client)
# ------------------------------------------------------------------------------
# Target Chain ID: 11155111 for Sepolia, 31337 for Localhost Hardhat
VITE_TARGET_CHAIN_ID=11155111

# Smart Contract Addresses (Populated automatically by deploy script, or manually configured)
VITE_CREDENTIAL_NFT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
VITE_REWARD_TOKEN_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
VITE_REGISTRY_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0

# Sepolia Public RPC (for read-only verification queries when no wallet is connected)
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Backend API Endpoint
VITE_API_URL=http://localhost:5000/api

# ------------------------------------------------------------------------------
# 3. Backend Server Configuration (server)
# ------------------------------------------------------------------------------
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/skills
JWT_SECRET=your_jwt_secret_token_change_in_production
STRIPE_SECRET_KEY=sk_test_placeholder_key
CLIENT_URL=http://localhost:5173
